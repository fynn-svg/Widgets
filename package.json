{
  "name": "jafy-widgets",
  "productName": "Jafy Widgets",
  "version": "2.3.0",
  "description": "Jafy Widgets: Widgets im Apple-Stil für den Windows-Desktop",
  "main": "main.js",
  "author": "Arsenii & Fynn",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "./build.sh"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "ch.jafy.widgets",
    "productName": "Jafy Widgets",
    "files": [
      "main.js",
      "preload.js",
      "dav.js",
      "tasks.js",
      "gcal.js",
      "desktop.js",
      "updater.js",
      "renderer/**",
      "assets/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_{ia32,arm64}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {}
  },
  "updateRepo": "fynn-svg/Widgets",
  "repository": {
    "type": "git",
    "url": "https://github.com/fynn-svg/Widgets.git"
  }
}